# Backend connection settings. Copy to .env and fill in your own project values.
# These are the public browser settings (the publishable key is safe to expose;
# row-level security is what protects the data).
VITE_SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publis..."

# Same values, read by server-side code (server functions and SSR).
SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publis..."

# Server-only. Provided by the hosting platform's secret store.
# NEVER commit this value and never add it to .env in a public repository.
SUPABASE_SERVICE_ROLE_KEY=""
